!/vowel-lab/index.html
!/vowel-lab/styles.css
!/vowel-lab/README.md
!/vowel-lab/THIRD-PARTY-NOTICES.txt
!/extract_score.mjs
!/package.json
!/package-lock.json
!/template/
!/vendor/
!/tests/
!/examples/
!/tools/
/tools/*
!/tools/local_station/
!/tools/build_song_vowel_map.py
!/tools/vowel-lab-routes.htaccess
!/tools/build_vowel_site_index.py
!/.github/

# Private extensions remain local; ordinary conversions do not load them.
