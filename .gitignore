# This working folder also holds private song builds and local deployment tools.
# Publish only the reusable pipeline; newly added top-level paths need review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/AGENTS.md
!/RELEASE_NOTES.md
!/build_trainer.py
!/collection.py
!/offline_player.py
